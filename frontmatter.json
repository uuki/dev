{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.templates.enabled": true,
  "frontMatter.content.autoUpdateDate": true,
  "frontMatter.content.defaultFileType": "mdx",
  "frontMatter.content.pageFolders": [
    {
      "title": "Blog posts",
      "path": "[[workspace]]/src/data/blog",
      "contentTypes": [
        "blog"
      ]
    },
    {
      "title": "Pages",
      "path": "[[workspace]]/src/data/pages",
      "excludeSubdir": true,
      "contentTypes": [
        "page"
      ]
    }
  ],
  "frontMatter.content.snippets": {
    "Image snippet": {
      "description": "Image with alt",
      "body": "![]([[&mediaUrl]])",
      "isMediaSnippet": true
    },
    "Note directive": {
      "description": "Note directive block",
      "body": ":::note\n[[selection]]\n:::"
    },
    "Warning directive": {
      "description": "Warning directive block",
      "body": ":::warning\n[[selection]]\n:::"
    }
  },
  "frontMatter.content.publicFolder": "public",
  "frontMatter.dashboard.openOnStart": false,
  "frontMatter.framework.id": "astro",
  "frontMatter.framework.startCommand": "pnpm dev",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.preview.pathName": "/blog/",
  "frontMatter.templates.prefix": "",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog",
      "pageBundle": false,
      "previewPath": "/blog/{{fileName}}/",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Slug",
          "name": "slug",
          "type": "string",
          "description": "URL-friendly identifier for internal posts"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Created date",
          "name": "created_at",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Updated date",
          "name": "updated_at",
          "type": "datetime",
          "isModifiedDate": true
        },
        {
          "title": "Is in draft",
          "name": "draft",
          "type": "boolean",
          "default": false
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "External URL",
          "name": "url",
          "type": "string",
          "description": "URL for external posts (Zenn, Qiita, etc.)"
        }
      ]
    },
    {
      "name": "page",
      "pageBundle": false,
      "previewPath": "/{{fileName}}/",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Created date",
          "name": "created_at",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Updated date",
          "name": "updated_at",
          "type": "datetime",
          "isModifiedDate": true
        }
      ]
    }
  ]
}