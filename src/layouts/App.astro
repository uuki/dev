---
import DocumentLayout, { type Props as DocumentProps } from '@/layouts/Document.astro';
import Header from '@/components/layouts/Header/Header.astro';
import Footer from '@/components/layouts/Footer/Footer.astro';
import Container from '@/components/layouts/Container/Container.astro';
import Toast from '@/components/features/Toast/Toast.svelte';
import { SESSION_KEYS } from '@/js/core/constants';

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
export interface Props extends DocumentProps {
  // Future: Add app-specific props here
}

const props = Astro.props;
---

<DocumentLayout {...props}>
  <Header />
  <Container>
    <slot />
  </Container>
  <Footer />
  <Toast
    client:load
    checkCompat
    sessionKey={SESSION_KEYS.COMPAT_TOAST_DISMISSED}
    triggers={[{ on: 'pageload', type: 'unsupported-browser', delay: 800 }]}
    types={[{
      name: 'unsupported-browser',
      label: 'お使いのブラウザは一部表示に未対応のため、正しく表示されない場合があります。'
    }]}
  />
</DocumentLayout>
