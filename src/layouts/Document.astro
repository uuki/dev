---
import { SEO } from 'astro-seo';
import { type MetaProps, createMeta } from '@/utils/meta';
import { siteConfig } from '@/data/constants';
import metaData from '@/data/meta.yml';
import GoogleAnalytics from '@/components/features/GoogleAnalytics/GoogleAnalytics.astro';
import ViewTransitionBridge from '@/components/features/ViewTransitionBridge/ViewTransitionBridge.astro';

import.meta.glob('@/styles/settings/**/*.scss', { eager: true });
import.meta.glob('@/styles/generic/**/*.scss', { eager: true });
import.meta.glob('@/styles/base/**/*.scss', { eager: true });
import.meta.glob('@/styles/utilities/**/*.scss', { eager: true });
import.meta.glob('@/styles/tools/plugins/**/*.scss', { eager: true });
import.meta.glob('@/styles/tools/animations/**/*.scss', { eager: true });

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
export interface Props extends MetaProps {
  // Future: Add document-specific props here
}

const props = Astro.props;
const meta = createMeta(props.meta);

// Site URLs and canonical
const siteUrl = Astro.site || import.meta.env.PUBLIC_ORIGIN || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Format titles and descriptions
const fullTitle = meta.title
  ? [meta.title, siteConfig.siteName].filter(Boolean).join(' - ')
  : siteConfig.siteName;

const ogTitle = meta['og:title']
  ? [meta['og:title'], siteConfig.siteName].filter(Boolean).join(' - ')
  : fullTitle;

const description = meta.description || metaData.description;
const ogDescription = meta['og:description'] || metaData['og:description'] || description;

// Format image URL
const ogImage = new URL(meta['og:image'] || '/og-default.png', siteUrl).toString();

const formats = {
  title: fullTitle,
  'og:title': ogTitle,
  description,
  'og:description': ogDescription,
  canonicalURL: canonicalURL.toString(),
  ogImage,
  type: meta.type,
};

const isTop = Astro.url.pathname === '/';
---

<!DOCTYPE html>
<html lang={siteConfig.lang} class={isTop ? 'is-top' : ''} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <SEO
      title={formats.title}
      description={formats.description}
      canonical={formats.canonicalURL}
      openGraph={{
        basic: {
          title: formats['og:title'],
          type: formats.type,
          image: formats.ogImage,
          url: formats.canonicalURL,
        },
        optional: {
          description: formats['og:description'],
          siteName: siteConfig.siteName,
          locale: 'ja_JP',
        },
        image: {
          url: formats.ogImage,
          alt: meta.title || siteConfig.siteName,
        },
      }}
      twitter={{
        card: 'summary_large_image',
      }}
    />
    <meta http-equiv="x-dns-prefetch-control" content="on" />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link rel="icon" type="image/png" href="/icons/favicon-32x32.png" />
    {siteConfig.feeds?.atom && <link rel="alternate" type="application/atom+xml" title="Atom Feed" href={siteConfig.feeds.atom} />}
    {siteConfig.feeds?.rss  && <link rel="alternate" type="application/rss+xml"  title="RSS Feed"  href={siteConfig.feeds.rss}  />}

    <GoogleAnalytics />
    <ViewTransitionBridge />
    <script>
      import '@/js/app';
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
