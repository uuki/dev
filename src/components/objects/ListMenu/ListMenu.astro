---
import { footerLinks } from '@/data/constants';

import styles from './ListMenu.module.scss';

---

<ul class={styles.listMenu}>
  {footerLinks.map((item) => (
    <li>
      <a href={item.path} class:list={[styles.listMenu__item, 'u-effect']} data-effect="line-in-out">{item.name}</a>
    </li>
  ))}
</ul>
