---
import ButtonNav from '../../ui/ButtonNav/ButtonNav.astro';
import styles from './Pagination.module.scss';

interface Props {
  currentPage: number;
  totalPages: number;
  getPageUrl: (page: number) => string;
}

const { currentPage, totalPages, getPageUrl } = Astro.props;

const prevLink = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextLink = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;
---

<div class={styles.pagination}>
  <nav class={styles.pagination__nav}>
    {prevLink ? (
      <a href={prevLink} class={styles.pagination__link}>
        <ButtonNav>
          <span class={styles.pagination__arrow}>←</span>
          Prev
        </ButtonNav>
      </a>
    ) : (
      <ButtonNav disabled={true}>
        <span class={styles.pagination__arrow}>←</span>
        Prev
      </ButtonNav>
    )}

    <span class={styles.pagination__info}>
      {currentPage}
      <span class={styles.pagination__of}>of</span>
      {totalPages}
    </span>

    {nextLink ? (
      <a href={nextLink} class={styles.pagination__link}>
        <ButtonNav>
          Next
          <span class={styles.pagination__arrow}>→</span>
        </ButtonNav>
      </a>
    ) : (
      <ButtonNav disabled={true}>
        Next
        <span class={styles.pagination__arrow}>→</span>
      </ButtonNav>
    )}
  </nav>
</div>
