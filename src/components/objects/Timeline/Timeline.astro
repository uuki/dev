---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { type Activity } from '@/types/activity';
import { format } from 'date-fns';

import PostCard from '@/components/ui/PostCard/PostCard.astro';

import style from './Timeline.module.scss';
import iconWrite from '@/assets/icons/write.svg';
import iconRocket from '@/assets/icons/rocket.svg';
import iconRibbon from '@/assets/icons/ribbon.svg';
import iconGitHub from '@/assets/icons/github.svg';
import iconComment from '@/assets/icons/comment.svg';

interface Props {
  year: number;
  data: Activity[];
}

const mapIcons = {
  article: iconWrite,
  release: iconRocket,
  contribution: iconGitHub,
  award: iconRibbon,
};

const titleFormats = {
  article: 'Posted article %%date%%',
  release: 'Released project %%date%%',
  contribution: 'Total number of contributions last year',
  award: 'Received award %%date%%',
};

const getFormat = (item: Activity) => {
  return (titleFormats[item.kind] || '').replace('%%date%%', format(new Date(item.date), 'MMM. d'));
}

const props = Astro.props;

const componentMap: Partial<Record<Activity['kind'], AstroComponentFactory>> = {
  article: PostCard,
} as const;

const getComponentByItem = (item: Activity) =>
  componentMap[item.kind] ?? null;

---

<section class={ style.timeline }>
  <div class={ style.timeline__header }>
    <h3 class={ style.timeline__year }>{props.year}</h3>
  </div>
  <div class={ style.timeline__row }>
    {props.data.map((item) => (
      <div class:list={[style.timeline__item]}>
        <div class={ style.timeline__meta }>
          <span class={ style.timeline__icon }>
            <img src={mapIcons[item.kind]?.src || iconComment.src} alt="" />
          </span>
          <h3 class={ style.timeline__title }>{getFormat(item)}</h3>
        </div>
        <div class:list={[style.timeline__content]}>
          <div class:list={[style.timeline__contentInner]}>
            {(() => {
              const Component = getComponentByItem(item);
              return Component ? <Component post={item} /> : null;
            })()}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
