---
import { menu } from '@/data/constants';
import Link from '../../ui/Link/Link.astro';
import styles from './Gnav.module.scss';

---

<nav class={styles.gnav}>
  <ul class={styles.gnav__list}>
    {menu.map((item) => (
      <li class={styles.gnav__item}>
        <a href={item.path}>{item.name}</a>
        {/* <Link href={item.path} variant="inOutWhite">
          {item.name}
        </Link> */}
      </li>
    ))}
  </ul>
</nav>
