---
import { navLinks } from '@/data/constants';
import styles from './Gnav.module.scss';

const gnavData = navLinks.map((it) => ({
  ...it,
  isActive: it.path === Astro.url.pathname,
}));
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

---

<nav class:list={[styles.gnav, className]}>
  <ul class:list={[styles.gnav__list, 'u-effect']} data-effect="anchor-hover">
    {gnavData.map((item) => (
      <li class={styles.gnav__item}>
        <a href={item.path} class={item.isActive ? '-active' : ''}>{item.name}</a>
      </li>
    ))}
  </ul>
</nav>
