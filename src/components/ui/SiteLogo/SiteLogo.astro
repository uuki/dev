---
import { Image } from 'astro:assets';
import Link, { type Props as LinkProps } from '../Link/Link.astro';
import styles from './SiteLogo.module.scss';

import imgSymbol from '@/assets/images/symbol.svg?raw';
import imgLogo from '@/assets/images/logo.jpg';

interface Props {
  noLink?: boolean;
}

const { noLink } = Astro.props;
const Component = (noLink ? 'span' : Link) as any;
const atts = (noLink ? {} : { href: "/", variant: "opacity" }) as LinkProps;
---

<Component {...atts} class={styles.siteLogo}>
  <Image
    src={imgLogo}
    width={20}
    height={20}
    alt="uuki.devのアイコン画像"
    class={styles.siteLogo__image}
    loading="eager"
  />
  <span class={styles.siteLogo__text} aria-label="uuki.dev"><Fragment set:html={imgSymbol} /></span>
</Component>
