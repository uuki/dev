---
import type { HTMLAttributes } from 'astro/types';
import styles from './PostHeader.module.scss';

interface Props extends HTMLAttributes<'h1'> {
  slug?: string;
}

const { slug, class: className, ...rest } = Astro.props;
const combinedClass = [styles.postHeader, className].filter(Boolean).join(' ');
---

<h1 class={combinedClass} {...rest} style={{ '--slug': slug }}>
  <slot />
</h1>
