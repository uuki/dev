---
import type { Activity, ArticleActivity } from '@/types/activity';
import type { CollectionEntry } from 'astro:content';
import Link from '@/components/ui/Link/Link.astro';
import BadgeOrigin from '@/components/ui/BadgeOrigin/BadgeOrigin.astro';
import ListTag from '@/components/ui/ListTag/ListTag.astro';
import ListMeta from '@/components/ui/ListMeta/ListMeta.astro';
import { detectOriginFromUrl } from '@/utils/origin';
import styles from './PostCard.module.scss';

interface Props {
  post: ArticleActivity; // CollectionEntry<'blog'>;
  key?: string;
}

const { post } = Astro.props;
const { id, title, tags, url } = post;
const slug = id.replace(/\.mdx?$/, '');

// Auto-detect origin from URL
const origin = detectOriginFromUrl(url);
---

<article class={styles.postCard} style={{ '--slug': slug }}>
  <div class={styles.postCard__origin}>
    <BadgeOrigin name={origin} />
  </div>
  <h2 class={styles.postCard__title}>
    <Link href={url || `/blog/${slug}`} variant="opacity">
      {title}
    </Link>
  </h2>
  <div class={styles.postCard__tags}>
    <ListTag tags={tags} />
  </div>
  <!-- <div class={styles.postCard__meta}>
    <ListMeta date={created_at} />
  </div> -->
</article>
