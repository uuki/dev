---
import { format, differenceInYears } from 'date-fns';
import waveCircle from '@/assets/shapes/wave-circle.svg?raw';

import styles from './ProfileCard.module.scss';

interface Props {
  showProgress?: boolean;
}

const props = Astro.props;
const now = new Date();

const jobNPastime = [
  {
    type: 'job',
    title: 'Frontend Developer',
    yearsOfExperience: differenceInYears(now, new Date(2013, 3)),
    description: '',
  },
  {
    type: 'job',
    title: 'Tech Lead',
    yearsOfExperience: differenceInYears(now, new Date(2021, 3)),
    description: '',
  },
  {
    type: 'hobby',
    title: 'Photo',
    yearsOfExperience: 'on a whim',
    description: 'Started with Nikon D3100, then D850 to α7iii.',
  },
  {
    type: 'hobby',
    title: 'Game',
    yearsOfExperience: 'to oblivion',
    description: 'Into BotW, Splatoon, Overcooked, and more.',
  },
  {
    type: 'hobby',
    title: 'Watching streams',
    yearsOfExperience: 'a lot',
    description: 'Into VTubers, RiJ, esports, and more.'
  },
  {
    type: 'hobby',
    title: 'Movies & Anime',
    yearsOfExperience: 'a lifetime',
    description: 'I bought Interstellar. I’m into Inception, Iron Man, and anime like Steins;Gate... too much to name.'
  }
];
---
<div class={ styles.profileCard }>
  <hgroup class={ styles.profileCard__header }>
    <span class={ styles.profileCard__sprite }>
      <Fragment set:html={waveCircle} / >
    </span>
    <h3 class={ styles.profileCard__name }>
      {'uuki'.split('').map(char => <span>{char}</span>)}
    </h3>
    <span class={ styles.profileCard__status }></span>
  </hgroup>
  <div class={ styles.profileCard__detail }>
    {!!props.showProgress && (
      <div class:list={[styles.profileCard__item, 'u-hidden-mobile', 'u-hidden-desktop-small']}>
        <h4 class={ styles.profileCard__title }>LOG PROGRESS</h4>
        <progress class:list={[styles.profileCard__progress, 'u-effect']} data-effect="progress-x" aria-hidden="true"></progress>
      </div>
    )}
    <div class={ styles.profileCard__item }>
      <h4 class={ styles.profileCard__title }>JOB & PASTIME</h4>
      <ul class={ styles.profileCard__list }>
        {
          jobNPastime.slice(0, 4).map(item => (
            <li>
              <hgroup class={ styles.profileCard__listHeader }>
                <h5 class={ styles.profileCard__listHeading }>{item.title}</h5>
                <b class={ styles.profileCard__listYears }>{item.type === 'job' ? 'YoE' : ''} {item.yearsOfExperience}</b>
              </hgroup>
              {!!item.description && <p class={ styles.profileCard__listDescription }>{item.description}</p>}
            </li>
          ))
        }
      </ul>
      <details class:list={[styles.profileCard__more, 'u-details-reset']}>
        <summary>Show More</summary>
        <div>
          <div class={styles.profileCard__moreContent}>
            <ul class={ styles.profileCard__list }>
              {
                jobNPastime.slice(4).map(item => (
                  <li>
                    <hgroup class={ styles.profileCard__listHeader }>
                      <h5 class={ styles.profileCard__listHeading }>{item.title}</h5>
                      <b class={ styles.profileCard__listYears }>{item.type === 'job' ? 'YoE' : ''} {item.yearsOfExperience}</b>
                    </hgroup>
                    {!!item.description && <p class={ styles.profileCard__listDescription }>{item.description}</p>}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </details>
    </div>
    <div class={ styles.profileCard__item }>
      <h4 class={ styles.profileCard__title }>NOTE</h4>
      <div class={ styles.profileCard__note }>
        <p>Partially fueled by curiosity. 🐿️</p>
      </div>
    </div>
  </div>
</div>
