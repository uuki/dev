---
import { format, differenceInYears } from 'date-fns';
import style from './ProfileCard.module.scss';
import imgLogo from '@/assets/images/logo.jpg';

interface Props {
}

const props = Astro.props;
const now = new Date();

const jobNPastime = [
  {
    type: 'job',
    title: 'Frontend Developer',
    yearsOfExperience: differenceInYears(now, new Date(2013, 3)),
    description: '',
  },
  {
    type: 'job',
    title: 'Tech Lead',
    yearsOfExperience: differenceInYears(now, new Date(2021, 3)),
    description: '',
  },
  {
    type: 'hobby',
    title: 'Photo',
    yearsOfExperience: 'on a whim',
    description: 'Started with Nikon D3100, then D850 to α7iii.',
  },
  {
    type: 'hobby',
    title: 'Game',
    yearsOfExperience: 'to oblivion',
    description: 'Into BotW, Splatoon, Overcooked, and more.',
  },
  {
    type: 'hobby',
    title: 'Watching streams',
    yearsOfExperience: 'a lot',
    description: 'Into VTubers, RiJ, esports, and more.'
  },
  {
    type: 'hobby',
    title: 'Movies & Anime',
    yearsOfExperience: 'a lifetime',
    description: 'I bought Interstellar. I’m into Inception, Iron Man, and anime like Steins;Gate... too much to name.'
  }
];
---
<div class={ style.profileCard }>
  <hgroup class={ style.profileCard__header }>
    <span class={ style.profileCard__sprite }></span>
    <h3 class={ style.profileCard__name }>
      {'uuki'.split('').map(char => <span>{char}</span>)}
    </h3>
    <span class={ style.profileCard__status }></span>
  </hgroup>
  <div class={ style.profileCard__detail }>
    <div class={ style.profileCard__item }>
      <h4 class={ style.profileCard__title }>PROGRESS</h4>
      <progress class:list={[style.profileCard__progress, 'u-effect']} data-effect="progress-x" aria-hidden="true"></progress>
    </div>
    <div class={ style.profileCard__item }>
      <h4 class={ style.profileCard__title }>JOB & PASTIME</h4>
      <ul class={ style.profileCard__list }>
        {
          jobNPastime.map(item => (
            <li>
              <hgroup class={ style.profileCard__listHeader }>
                <h5 class={ style.profileCard__listHeading }>{item.title}</h5>
                <b class={ style.profileCard__listYears }>{item.type === 'job' ? 'YoE' : ''} {item.yearsOfExperience}</b>
              </hgroup>
              {!!item.description && <p class={ style.profileCard__listDescription }>{item.description}</p>}
            </li>
          ))
        }
      </ul>
    </div>
    <div class={ style.profileCard__item }>
      <h4 class={ style.profileCard__title }>NOTE</h4>
      <div class={ style.profileCard__note }>
        <p>Sample Profile Text Sample Profile TextSample Profile TextSample Profile TextSample Profile TextSample Profile TextSample Profile Text</p>
      </div>
    </div>
  </div>
</div>
