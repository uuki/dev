---
/**
 * PostHistory Component
 */
import type { PostRevision } from '@/types/post';
import { getCompareUrl } from '@/utils/git';
import { iconMap } from '@/data/constants';

import styles from './PostHistory.module.scss';

interface Props {
  history: PostRevision[];
  repoUrl?: string;
}

const { history, repoUrl } = Astro.props;

// 日付フォーマット関数（date-fns互換）
const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const day = String(date.getDate()).padStart(2, '0');
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
};
---

{history.length > 0 && (
  <details class={styles.postHistory}>
    <summary class={styles.postHistory__summary}>
      <Fragment set:html={iconMap['clock']} />
      編集履歴
    </summary>
    <div class={styles.postHistory__dropdown}>
      <div class={styles.postHistory__scroll}>
        <ul class={styles.postHistory__list}>
          {history.map((item, index) => {
            const isInitialCommit = index >= history.length - 1;
            const hasCompareLink = !isInitialCommit && repoUrl && history[index + 1];
            const compareUrl = hasCompareLink
              ? getCompareUrl(repoUrl!, item.hash, history[index + 1].hash)
              : null;

            return (
              <li class={styles.postHistory__item} data-index={index}>
                {compareUrl ? (
                  <a
                    href={compareUrl}
                    class={styles.postHistory__link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <div class={styles.postHistory__content}>
                      <span class={styles.postHistory__hash}>{item.hash}</span>
                      <span class={styles.postHistory__date}>
                        {formatDate(item.authorDate)}
                        {isInitialCommit && ' (Initial commit)'}
                      </span>
                    </div>
                  </a>
                ) : (
                  <div class={styles.postHistory__content}>
                    <span class={styles.postHistory__hash}>{item.hash}</span>
                    <span class={styles.postHistory__date}>
                      {formatDate(item.authorDate)}
                      {isInitialCommit && ' (Initial commit)'}
                    </span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </details>
)}
