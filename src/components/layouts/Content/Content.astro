---
import style from './Content.module.scss';

interface Props {
  class?: string;
  variant?: 'narrow';
}

const { class: className, variant } = Astro.props;
const modifiers = {
  narrow: style['-narrow'],
};
---
<div class:list={[style.content, variant ? modifiers[variant] : '', className]}>
  <slot />
</div>
