---
import Link from '../../ui/Link/Link.astro';
import ListMenu from '../../objects/ListMenu/ListMenu.astro';
import { siteConfig, iconMap } from '@/data/constants';

import styles from './Footer.module.scss';
const currentYear = new Date().getFullYear();
---

<footer class={styles.footer}>
  <div class={styles.footer__content}>
    <ul class={styles.footer__socialList}>
      {siteConfig.social.map((it) => (
        <li class={styles.footer__socialItem}>
          <Link href={it.url} class={styles.footer__socialLink} aria-label={it.label}>
            <Fragment set:html={iconMap[it.type]} />
          </Link>
        </li>
      ))}
      <li class={styles.footer__socialItem}>
        <Link href={siteConfig.feeds.atom} class={styles.footer__socialLink} aria-label="RSS">
          <Fragment set:html={iconMap['rss']} />
        </Link>
      </li>
    </ul>
    <div class={styles.footer__menu}>
      <ListMenu />
    </div>
  </div>
  <div class={styles.footer__copyright}>
    <small>© 2017-{currentYear} uuki.dev</small>
  </div>
</footer>
