---
import Link from '../../ui/Link/Link.astro';
import ListMenu from '../../objects/ListMenu/ListMenu.astro';
import { siteConfig, iconMap } from '@/data/constants';

import styles from './Footer.module.scss';
const currentYear = new Date().getFullYear();
---

<footer class={styles.footer}>
  <nav class={styles.footer__content}>
    <div class={styles.footer__socialArea}>
      <ul class:list={[styles.footer__list, 'u-effect']} data-effect="anchor-hover">
        {siteConfig.social.map((it) => (
          <li>
            <a href={it.url} target="_blank" rel="noopener" class={styles.footer__socialItem} aria-label={it.label}>
              <Fragment set:html={iconMap[it.type]} />
            </a>
          </li>
        ))}
        <li>
          <a href={siteConfig.feeds.atom} target="_blank" rel="noopener" class={styles.footer__socialItem} aria-label="RSS">
            <Fragment set:html={iconMap['rss']} />
          </a>
        </li>
      </ul>
    </div>
    <div class={styles.footer__menu}>
      <ListMenu />
    </div>
  </nav>
  <div class={styles.footer__copyright}>
    <small>© 2017-{currentYear} uuki.dev</small>
  </div>
</footer>
