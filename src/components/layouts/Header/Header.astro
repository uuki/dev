---
import SiteLogo from '@/components/ui/SiteLogo/SiteLogo.astro';
import Gnav from '@/components/objects/Gnav/Gnav.astro';
import ButtonHamburger from '@/components/ui/ButtonHamburger/ButtonHamburger.astro';

import styles from './Header.module.scss';

const isTop = Astro.url.pathname === '/';
const Component = isTop ? 'h1' : 'div';
---

<header class={styles.header}>
  <div class={styles.header__content}>
    <div class={styles.header__logoTransformX}>
      <div class={styles.header__logoTransformY}>
        <Component class={styles.header__logo}>
          <SiteLogo noLink={isTop} />
        </Component>
      </div>
    </div>
    <div class={styles.header__nav}>
      <Gnav class="u-hidden-mobile" />
      <ButtonHamburger class="u-hidden-desktop" />
    </div>
  </div>
</header>
