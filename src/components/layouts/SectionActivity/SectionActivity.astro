---
import { type Activity } from '@/types/activity';
import ContentLayout from '@/components/layouts/Content/Content.astro';
import Timeline from '@/components/objects/Timeline/Timeline.astro';
import HeadingSection from '@/components/ui/HeadingSection/HeadingSection.astro';
import ProfileCard from '@/components/ui/ProfileCard/ProfileCard.astro';

import style from './SectionActivity.module.scss';

interface Props {
  data: Activity[];
}

const props = Astro.props;

type YearGroup = { year: number; items: Activity[] };

const activitiesByYear = props.data.reduce<YearGroup[]>((groups, activity) => {
  const year = Number(activity.date.slice(0, 4));
  const group = groups.find((g) => g.year === year);
  if (group) {
    group.items.push(activity);
  } else {
    groups.push({ year, items: [activity] });
  }
  return groups;
}, []);
---
<section class:list={[style.sectionActivity, 'u-effect']} data-effect-root="progress-x">
  <ContentLayout>
    <div class={ style.sectionActivity__header }>
      <HeadingSection heading="h2">Activity Log</HeadingSection>
    </div>
    <div class={ style.sectionActivity__content }>
      <div class={ style.sectionActivity__profile }>
        <ProfileCard />
      </div>
      <div class={ style.sectionActivity__timeline }>
        {activitiesByYear.map(({ year, items }) => (
          <Timeline year={year} data={items} />
        ))}
      </div>
    </div>
  </ContentLayout>
</section>

<script define:vars={{ activitiesByYear }}>
  console.log(activitiesByYear);
</script>
