---
import { getEntry, render } from 'astro:content';
import AppLayout from '@/layouts/App.astro';
import styles from './page.module.scss';

const entry = await getEntry('pages', 'privacy');

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
const { title, description } = entry.data;

const meta = {
  title,
  description: description ?? undefined,
};
---

<AppLayout meta={meta}>
  <div class={styles.page}>
    <main class={styles.page__main}>
      <div class={styles.page__container}>
        <article class={styles.page__article}>
          <h1 class={styles.page__title}>{title}</h1>
          <div class={styles.page__content}>
            <Content />
          </div>
        </article>
      </div>
    </main>
  </div>
</AppLayout>
