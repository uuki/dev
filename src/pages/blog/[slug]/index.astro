---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import AppLayout from '@/layouts/App.astro';
import PostHeader from '@/components/ui/PostHeader/PostHeader.astro';
import ListTag from '@/components/ui/ListTag/ListTag.astro';
import ListMeta from '@/components/ui/ListMeta/ListMeta.astro';
import ListSocial from '@/components/objects/ListSocial/ListSocial.astro';
import OptimizedImage from '@/components/ui/OptimizedImage/OptimizedImage.astro';
import PostHistory from '@/components/objects/PostHistory/PostHistory.astro';
import { getFileRevision } from '@/utils/git';
import { siteConfig } from '@/data/constants';
import PostDate from '@/components/ui/PostDate/PostDate.astro';

import styles from './index.module.scss';

export const getStaticPaths = (async () => {
  const allPosts = await getCollection('blog', ({ data }) => {
    // Only include posts that don't have an external URL and are not drafts
    return !data.draft && !data.url;
  });

  return allPosts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { id: post.id },
  }));
}) satisfies GetStaticPaths;

interface Props {
  id: string;
}

const { id } = Astro.props;
const post = await getEntry('blog', id);

if (!post) {
  return Astro.redirect('/404');
}

const { Content, remarkPluginFrontmatter } = await render(post);

const { title, description, created_at, tags = [] } = post.data;
const slug = post.id.replace(/\.mdx?$/, '');

// Git history retrieval
const history = siteConfig.git?.enabled
  ? getFileRevision({
      slug: `blog/${slug}`,
      limit: siteConfig.git.maxCommits || 10
    })
  : [];

// Optional frontmatter fields not in schema
interface OptionalBlogFields {
  heroImage?: string;
}

const heroImage = (post.data as typeof post.data & OptionalBlogFields).heroImage;

// Use heroImage or default OG image
// To use custom OG images per post, add them to public/og/ and reference in frontmatter
const ogImageUrl = heroImage || `/og-default.png`;

const meta = {
  title,
  description: description ?? undefined,
  'og:image': ogImageUrl,
  type: 'article' as const,
};

const readingTime: number = remarkPluginFrontmatter.readingTime ?? 0;
---

<AppLayout meta={meta}>
  <div class={styles.blogPost}>
    <main class={styles.blogPost__main}>
      <article class={styles.blogPost__article}>
        <div class={styles.blogPost__container}>
          <div class={styles.blogPost__header}>
            <PostHeader slug={slug}>{title}</PostHeader>
            <div class={styles.blogPost__tags}>
              <ListTag tags={tags} />
            </div>
            <ul class={styles.blogPost__meta}>
              {created_at && (
                <li class={styles.listMeta__item}>
                  <span class={styles.listMeta__icon}>✏️</span>
                  <PostDate date={created_at} />
                </li>
              )}
              {readingTime && (
                <li class={styles.listMeta__item}>
                  <span class={styles.listMeta__icon}>📖</span>
                  {Math.round(readingTime)} min read
                </li>
              )}
              {history.length > 0 && (
                <PostHistory
                  history={history}
                  repoUrl={siteConfig.git?.repoUrl}
                />
              )}
            </ul>
          </div>

          {heroImage && (
            <div class={styles.blogPost__heroImage}>
              <OptimizedImage
                src={heroImage}
                alt={title}
                width={800}
                height={450}
                loading="eager"
                class={styles.blogPost__heroImageElement}
              />
            </div>
          )}

          <div class={styles.blogPost__content}>
            <div class={styles.prose}>
              <Content />
            </div>
            <div class={styles.blogPost__share}>
              <ListSocial pathname={`/blog/${slug}`} text={title} />
            </div>
          </div>
        </div>
      </article>
    </main>
  </div>
</AppLayout>
