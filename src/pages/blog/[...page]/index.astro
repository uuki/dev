---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import AppLayout from '@/layouts/App.astro';
import PageHeader from '@/components/ui/PageHeader/PageHeader.astro';
// import InputText from '@/components/ui/InputText/InputText.astro';
import PostCard from '@/components/ui/PostCard/PostCard.astro';
import Pagination from '@/components/objects/Pagination/Pagination.astro';
import { normalizeBlogEntry } from '@/utils/normalizeActivities';
import styles from './index.module.scss';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ data }) => {
    return !data.draft;
  });

  // Sort posts by created_at (newest first)
  const sortedPosts = allPosts.sort((a, b) => {
    return b.data.created_at.getTime() - a.data.created_at.getTime();
  });

  const POSTS_PER_PAGE = 10;

  return paginate(sortedPosts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const posts = page.data.map(normalizeBlogEntry);
---

<AppLayout meta={{ title: 'All Posts', description: 'uuki.devのブログ記事一覧' }}>
  <div class={styles.blogList}>
    <main class={styles.blogList__main}>
      <div class={styles.blogList__content}>
        <div class={styles.blogList__container}>
          <div class={styles.blogList__header}>
            <PageHeader>All Posts</PageHeader>
          </div>

          <ul class={styles.blogList__posts}>
            {posts.map((post) => (
              <li class={styles.blogList__postItem}>
                <div class={styles.blogList__postCard}>
                  <PostCard post={post} />
                </div>
              </li>
            ))}
          </ul>

          {page.lastPage > 1 && (
            <Pagination currentPage={page.currentPage} totalPages={page.lastPage} basePath="/blog" />
          )}
        </div>
      </div>
    </main>
  </div>
</AppLayout>
