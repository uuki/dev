---
import { normalizeBlogEntry } from '@/utils/normalizeActivities';
import { getSortedPosts, POSTS_PER_PAGE, getBlogPageUrl } from '@/utils/blog';

import AppLayout from '@/layouts/App.astro';
import Content from '@/components/layouts/Content/Content.astro';
import Pagination from '@/components/objects/Pagination/Pagination.astro';
import PostCard from '@/components/ui/PostCard/PostCard.astro';
import HeadingPage from '@/components/ui/HeadingPage/HeadingPage.astro';

import styles from './archive.module.scss';

const allPosts = await getSortedPosts();
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const posts = allPosts.slice(0, POSTS_PER_PAGE).map(normalizeBlogEntry);

const meta = {
  title: 'All Posts',
  description: 'uuki.devのブログ記事一覧',
};
---

<AppLayout meta={meta}>
  <div class={styles.archive}>
    <Content variant='narrow'>
      <div class={styles.archive__content}>
        <div class={styles.archive__header}>
          <HeadingPage heading='h1'>All Posts</HeadingPage>
        </div>
        <ul class={styles.archive__list}>
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
        <nav class={styles.archive__pagination}>
          {totalPages > 1 && (
            <Pagination currentPage={1} totalPages={totalPages} getPageUrl={getBlogPageUrl} />
          )}
        </nav>
      </div>
    </Content>
  </div>
</AppLayout>
