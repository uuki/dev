---
import AppLayout from '@/layouts/App.astro';
import { getCollection } from 'astro:content';
import Hero from '@/components/objects/Hero/Hero.astro';
import BlogCard from '@/components/objects/BlogCard/BlogCard.astro';
import Link from '@/components/ui/Link/Link.astro';
import styles from './index.module.scss';

// Get all blog posts (including external posts)
const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort by created_at descending
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime();
});

// Take first 5 posts
const recentPosts = sortedPosts.slice(0, 5);
---
<AppLayout>
  <div class={styles.top}>
    <main class={styles.top__main}>
      <div class={styles.top__container}>
        <div class={styles.top__hero}>
          <Hero />
        </div>
        <div class={styles.top__content}>
          <ul class={styles.top__posts}>
            {recentPosts.map((post, i) => (
              <li class={styles.top__postItem}>
                <BlogCard post={post} key={String(i)} />
              </li>
            ))}
          </ul>
          <div class={styles.top__more}>
            <Link href="/blog/" variant="opacity" class={styles.top__moreLink}>
              <span>記事一覧へ</span>
              <span class={styles.top__moreIcon}>→</span>
            </Link>
          </div>
        </div>
      </div>
    </main>
  </div>
</AppLayout>
