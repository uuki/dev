---
import { getEntry, render } from 'astro:content';
import AppLayout from '@/layouts/App.astro';
import Author from '@/components/ui/Author/Author.astro';
import { siteConfig, socialIconMap, contactIconMap } from '@/data/constants';

import HeadingPage from '@/components/ui/HeadingPage/HeadingPage.astro';
import Content from '@/components/layouts/Content/Content.astro';
import styles from './about.module.scss';

const entry = await getEntry('pages', 'about');

if (!entry) {
  return Astro.redirect('/');
}

const { Content: PageContent } = await render(entry);
const { title, description } = entry.data;

const meta = {
  title,
  description: description ?? undefined,
};

const profileLinks = [
  ...(siteConfig.social ?? []).map((l) => ({ ...l, icon: socialIconMap[l.type] })),
  ...(siteConfig.contact ?? []).map((l) => ({ ...l, icon: contactIconMap[l.type] })),
];
---

<AppLayout meta={meta}>
  <div class={styles.about}>
    <Content variant='narrow'>
      <div class={styles.about__content}>
        <div class={styles.about__header}>
          <HeadingPage heading='h1' class={styles.about__heading}>{title}</HeadingPage>
        </div>

        <div class={styles.about__authorWrapper}>
          <Author />
        </div>
        <ul class={styles.about__socialList}>
          {profileLinks.map((link) => (
            <li class={styles.about__socialItem}>
              <a href={link.url} class={styles.about__socialLink} aria-label={link.label}>
                <Fragment set:html={link.icon} />
              </a>
            </li>
          ))}
        </ul>

        <article class={styles.about__article}>
          <PageContent />
        </article>
      </div>
    </Content>
  </div>
</AppLayout>
