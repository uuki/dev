---
import { getEntry, render } from 'astro:content';
import AppLayout from '@/layouts/App.astro';
import Author from '@/components/ui/Author/Author.astro';
import HeadingPage from '@/components/ui/HeadingPage/HeadingPage.astro';
import Content from '@/components/layouts/Content/Content.astro';
import PageWysiwyg from '@/components/layouts/PageWysiwyg/PageWysiwyg.astro';
import styles from './about.module.scss';

const entry = await getEntry('pages', 'about');

if (!entry) {
  return Astro.redirect('/');
}

const { Content: PageContent } = await render(entry);
const { title, description } = entry.data;

const meta = {
  title,
  description: description ?? undefined,
};
---

<AppLayout meta={meta}>
  <div class={styles.about}>
    <Content variant='narrow'>
      <div class={styles.about__content}>
        <div class={styles.about__header}>
          <HeadingPage heading='h1' class={styles.about__heading}>{title}</HeadingPage>
        </div>
        <div class={styles.about__profile}>
          <Author />
        </div>
        <article class={styles.about__body}>
          <PageWysiwyg>
            <PageContent />
          </PageWysiwyg>
        </article>
      </div>
    </Content>
  </div>
</AppLayout>
