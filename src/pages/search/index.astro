---
import AppLayout from '@/layouts/App.astro';
import PageHeader from '@/components/ui/PageHeader/PageHeader.astro';
import styles from './index.module.scss';

const meta = {
  title: 'Search',
  description: 'Search articles on uuki.dev',
};
---

<AppLayout meta={meta}>
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </Fragment>

  <div class={styles.searchPage}>
    <main class={styles.searchPage__main}>
      <div class={styles.searchPage__container}>
        <PageHeader>{meta.title}</PageHeader>
        <div class={styles.searchPage__content}>
          <div id="search" class={styles.searchPage__widget}></div>
        </div>
      </div>
    </main>
  </div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        excerptLength: 15,
        translations: {
          placeholder: 'Search articles...',
          clear_search: 'Clear',
          load_more: 'Load more results',
          search_label: 'Search this site',
          filters_label: 'Filters',
          zero_results: 'No results for [SEARCH_TERM]',
          many_results: '[COUNT] results for [SEARCH_TERM]',
          one_result: '[COUNT] result for [SEARCH_TERM]',
          alt_search: 'No results for [SEARCH_TERM]. Showing results for [DIFFERENT_TERM] instead',
          search_suggestion: 'No results for [SEARCH_TERM]. Try one of the following searches:',
          searching: 'Searching for [SEARCH_TERM]...',
        },
      });
    });
  </script>
</AppLayout>
