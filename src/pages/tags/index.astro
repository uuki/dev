---
import BaseHead from '../../components/layouts/BaseHead/BaseHead.astro';
import Header from '../../components/layouts/Header/Header.astro';
import Footer from '../../components/layouts/Footer/Footer.astro';
import PageHeader from '../../components/ui/PageHeader/PageHeader.astro';
import LinkTag from '../../components/ui/LinkTag/LinkTag.astro';
import { getAllTags, getAllTagNames } from '../../utils/tags';
import styles from './index.module.scss';

const tagCounts = await getAllTags();
const tagNames = await getAllTagNames();

// Create a map of slugified tags to original tag names
const slugToName: Record<string, string> = {};
tagNames.forEach((name) => {
  const slug = name.toLowerCase().replace(/\s+/g, '-');
  slugToName[slug] = name;
});

// Sort tags by count (descending)
const sortedTags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a]);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="Tags" description="タグ一覧" type="website" />
  </head>
  <body>
    <div class={styles.tags}>
      <Header />
      <main class={styles.tags__main}>
        <div class={styles.tags__wrapper}>
          <div class={styles.tags__container}>
            <div class={styles.tags__content}>
              <div class={styles.tags__header}>
                <PageHeader>Tags</PageHeader>
              </div>

              <ul class={styles.tags__list}>
                {sortedTags.map((tagSlug) => (
                  <li class={styles.tags__item}>
                    <LinkTag tag={slugToName[tagSlug] || tagSlug} />
                    <span class={styles.tags__count}>({tagCounts[tagSlug]})</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>

  </body>
</html>
