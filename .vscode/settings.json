{
  "files.associations": {
    "*.css": "postcss"
  },
  "yaml.schemaStore.enable": false,
  "css.customData": [
    "./.vscode/css.json"
  ],
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[mdx]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.dropIntoEditor.enabled": true
  }
}
