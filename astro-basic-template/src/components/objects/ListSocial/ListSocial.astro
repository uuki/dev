---
import styles from './ListSocial.module.scss';

interface Props {
  pathname: string;
  text?: string;
}

const { pathname, text = '' } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://uuki.dev';
const siteName = 'uuki.dev';
const url = encodeURIComponent(`${siteUrl}${pathname}`);
const urlText = text ? `${encodeURIComponent(text)} - ${siteName}` : '';

const createQueryString = (params: Record<string, string>) => {
  return Object.keys(params)
    .map((key) => `${key}=${params[key]}`)
    .join('&');
};

const shareItems = [
  {
    name: 'Twitter',
    url: `https://x.com/intent/post?${createQueryString({ url, ...(urlText && { text: urlText }) })}`,
    icon: '𝕏',
    color: '#000000',
  },
  {
    name: 'Hatena',
    url: `http://b.hatena.ne.jp/add?${createQueryString({ url, mode: 'confirm' })}`,
    icon: 'B!',
    color: '#00a4de',
  },
  {
    name: 'Pocket',
    url: `https://getpocket.com/edit?${createQueryString({ url, ...(urlText && { text: urlText }) })}`,
    icon: '📖',
    color: '#ef4056',
  },
];
---

<ul class={styles.listSocial}>
  {shareItems.map((item) => (
    <li class={styles.listSocial__item}>
      <button
        type="button"
        class={styles.listSocial__button}
        data-share-url={item.url}
        aria-label={`Share on ${item.name}`}
      >
        <span style={`color: ${item.color};`}>{item.icon}</span>
      </button>
    </li>
  ))}
</ul>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shareButtons = document.querySelectorAll('[data-share-url]');

    shareButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const shareUrl = target.getAttribute('data-share-url');

        if (shareUrl) {
          window.open(
            shareUrl,
            '',
            'menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=400,width=580'
          );
        }
      });
    });
  });
</script>
