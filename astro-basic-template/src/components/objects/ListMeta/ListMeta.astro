---
import PostDate from '../../ui/PostDate/PostDate.astro';
import styles from './ListMeta.module.scss';

interface Props {
  date?: Date | string;
  readingTime?: number; // minutes
}

const { date, readingTime } = Astro.props;
---

<ul class={styles.listMeta}>
  {date && (
    <li class={styles.listMeta__item}>
      <span class={styles.listMeta__icon}>✏️</span>
      <PostDate date={date} />
    </li>
  )}
  {readingTime && (
    <li class={styles.listMeta__item}>
      <span class={styles.listMeta__icon}>📖</span>
      {Math.round(readingTime)} min read
    </li>
  )}
</ul>
