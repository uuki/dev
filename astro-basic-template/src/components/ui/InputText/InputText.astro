---
import type { HTMLAttributes } from 'astro/types';
import styles from './InputText.module.scss';

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  type?: 'text' | 'email' | 'password' | 'search';
}

const { type = 'text', class: className, ...rest } = Astro.props;
const combinedClass = [styles.inputText, className].filter(Boolean).join(' ');
---

<input type={type} class={combinedClass} {...rest} />
