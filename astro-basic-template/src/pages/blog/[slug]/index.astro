---
import type { GetStaticPaths } from 'astro';
import type { SiteConfig } from '../../../types/config';
import { getCollection, getEntry, render } from 'astro:content';
import BaseHead from '../../../components/layouts/BaseHead/BaseHead.astro';
import Header from '../../../components/layouts/Header/Header.astro';
import Footer from '../../../components/layouts/Footer/Footer.astro';
import PostHeader from '../../../components/ui/PostHeader/PostHeader.astro';
import ListTag from '../../../components/objects/ListTag/ListTag.astro';
import ListMeta from '../../../components/objects/ListMeta/ListMeta.astro';
import ListSocial from '../../../components/objects/ListSocial/ListSocial.astro';
import OptimizedImage from '../../../components/ui/OptimizedImage/OptimizedImage.astro';
import PostHistory from '../../../components/objects/PostHistory/PostHistory.astro';
import { getFileRevision } from '../../../utils/git';
import configData from '../../../data/config.yml';
import styles from './index.module.scss';

const config = configData as unknown as SiteConfig;

export const getStaticPaths = (async () => {
  const allPosts = await getCollection('blog', ({ data }) => {
    // Only include posts that don't have an external URL and are not drafts
    return !data.draft && !data.url;
  });

  return allPosts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { id: post.id },
  }));
}) satisfies GetStaticPaths;

interface Props {
  id: string;
}

const { id } = Astro.props;
const post = await getEntry('blog', id);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);

const { title, description, date, tags = [], heroImage } = post.data;
const slug = post.id.replace(/\.mdx?$/, '');

// Git history retrieval
const history = config.git?.enabled
  ? getFileRevision({
      slug: `blog/${slug}`,
      limit: config.git.maxCommits || 10
    })
  : [];

// Use heroImage or default OG image
// To use custom OG images per post, add them to public/og/ and reference in frontmatter
const ogImageUrl = heroImage || `/og-default.png`;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description ?? undefined} image={ogImageUrl} type="article" />
  </head>
  <body>
    <div class={styles.blogPost}>
      <Header />
      <main class={styles.blogPost__main}>
        <article class={styles.blogPost__article}>
          <div class={styles.blogPost__container}>
            <div class={styles.blogPost__header}>
              <PostHeader>{title}</PostHeader>
              <div class={styles.blogPost__tags}>
                <ListTag tags={tags} />
              </div>
              <div class={styles.blogPost__meta}>
                <ListMeta date={date} />
                {history.length > 0 && (
                  <PostHistory
                    history={history}
                    repoUrl={config.git?.repoUrl}
                  />
                )}
              </div>
            </div>

            {heroImage && (
              <div class={styles.blogPost__heroImage}>
                <OptimizedImage
                  src={heroImage}
                  alt={title}
                  width={800}
                  height={450}
                  loading="eager"
                  class={styles.blogPost__heroImageElement}
                />
              </div>
            )}

            <div class={styles.blogPost__content}>
              <div class={styles.prose}>
                <Content />
              </div>
              <div class={styles.blogPost__share}>
                <ListSocial pathname={`/blog/${slug}`} text={title} />
              </div>
            </div>
          </div>
        </article>
      </main>
      <Footer />
    </div>
  </body>
</html>
