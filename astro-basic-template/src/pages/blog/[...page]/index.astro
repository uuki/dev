---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/layouts/BaseHead/BaseHead.astro';
import Header from '../../../components/layouts/Header/Header.astro';
import Footer from '../../../components/layouts/Footer/Footer.astro';
import PageHeader from '../../../components/ui/PageHeader/PageHeader.astro';
import InputText from '../../../components/ui/InputText/InputText.astro';
import BlogCard from '../../../components/objects/BlogCard/BlogCard.astro';
import Pagination from '../../../components/objects/Pagination/Pagination.astro';
import styles from './index.module.scss';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ data }) => {
    return !data.draft;
  });

  // Sort posts by date (newest first)
  const sortedPosts = allPosts.sort((a, b) => {
    return b.data.date.getTime() - a.data.date.getTime();
  });

  const POSTS_PER_PAGE = 10;

  return paginate(sortedPosts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="All Posts" description="uuki.devのブログ記事一覧" type="website" />
  </head>
  <body>
    <div class={styles.blogList}>
      <Header />
      <main class={styles.blogList__main}>
        <div class={styles.blogList__content}>
          <div class={styles.blogList__container}>
            <div class={styles.blogList__header}>
              <PageHeader>All Posts</PageHeader>
            </div>

            <div class={styles.blogList__search}>
              <InputText
                type="search"
                placeholder="Search articles"
                aria-label="Search articles"
                class={styles.blogList__searchInput}
              />
            </div>

            <ul class={styles.blogList__posts}>
              {page.data.map((post) => (
                <li class={styles.blogList__postItem}>
                  <div class={styles.blogList__postCard}>
                    <BlogCard post={post} />
                  </div>
                </li>
              ))}
            </ul>

            {page.lastPage > 1 && (
              <Pagination currentPage={page.currentPage} totalPages={page.lastPage} basePath="/blog" />
            )}
          </div>
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
